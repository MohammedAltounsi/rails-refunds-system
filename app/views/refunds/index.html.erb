<% content_for :title, "Refunds" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-xl font-semibold">Refunds</h1>
  <%= link_to "Issue a refund", new_refund_path, class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
</div>

<div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">ID</th>
        <th class="px-4 py-3">Charge</th>
        <th class="px-4 py-3">Amount</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3">Created</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @refunds.each do |refund| %>
        <tr>
          <td class="px-4 py-3"><%= link_to "##{refund.id}", refund, class: "text-slate-900 hover:underline" %></td>
          <td class="px-4 py-3"><%= link_to refund.charge.stripe_payment_intent_id, refund.charge, class: "text-slate-600 hover:underline" %></td>
          <td class="px-4 py-3"><%= money(refund.amount_cents) %></td>
          <td class="px-4 py-3"><%= status_badge(refund.status) %></td>
          <td class="px-4 py-3 text-slate-500"><%= refund.created_at.strftime("%b %-d, %H:%M") %></td>
        </tr>
      <% end %>
      <% if @refunds.empty? %>
        <tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">No refunds yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
