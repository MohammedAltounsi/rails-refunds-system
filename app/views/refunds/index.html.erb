<% content_for :title, "Refunds" %>

<div class="rise">
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="desk-title text-3xl text-ink">refunds</h1>
      <p class="mt-2 max-w-lg text-sm text-ink-dim">
        Send money back to a customer. Every riyal is tracked, and the books always balance.
      </p>
    </div>
    <%= link_to "issue refund", new_refund_path, class: "btn btn-primary self-start sm:self-auto" %>
  </div>

  <% if demo_mode? %>
    <div class="panel mb-8 p-6">
      <p class="meta mb-1">start here</p>
      <p class="mb-6 max-w-xl text-sm text-ink-dim">
        Try it yourself. Run a refund and watch the money move, one step at a time.
      </p>

      <ol class="grid gap-4 sm:grid-cols-3">
        <li class="rounded-xl border border-line bg-bg p-5">
          <div class="mb-3 flex items-center gap-2.5">
            <span class="grid h-7 w-7 place-items-center rounded-full border border-line font-mono text-sm text-credit">1</span>
            <span class="font-mono text-xs uppercase tracking-wide text-ink">start it</span>
          </div>
          <p class="text-sm leading-relaxed text-ink-dim">Pick a payment and <%= link_to "give some money back", new_refund_path, class: "text-ink underline decoration-line underline-offset-4 hover:text-credit" %>.</p>
        </li>
        <li class="rounded-xl border border-line bg-bg p-5">
          <div class="mb-3 flex items-center gap-2.5">
            <span class="grid h-7 w-7 place-items-center rounded-full border border-line font-mono text-sm text-credit">2</span>
            <span class="font-mono text-xs uppercase tracking-wide text-ink">confirm it</span>
          </div>
          <p class="text-sm leading-relaxed text-ink-dim">On the refund, press the green button to approve it. The money moves.</p>
        </li>
        <li class="rounded-xl border border-line bg-bg p-5">
          <div class="mb-3 flex items-center gap-2.5">
            <span class="grid h-7 w-7 place-items-center rounded-full border border-line font-mono text-sm text-credit">3</span>
            <span class="font-mono text-xs uppercase tracking-wide text-ink">check it</span>
          </div>
          <p class="text-sm leading-relaxed text-ink-dim">Open the <%= link_to "ledger", ledger_path, class: "text-ink underline decoration-line underline-offset-4 hover:text-credit" %> and see it add up. It always balances.</p>
        </li>
      </ol>

      <p class="mt-5 font-mono text-xs text-ink-faint">this is a demo · no real money moves</p>
    </div>
  <% end %>

  <div class="panel overflow-x-auto">
    <table class="ledger-table">
      <thead>
        <tr>
          <th>refund</th>
          <th>charge</th>
          <th class="text-right">amount</th>
          <th>status</th>
          <th class="text-right">created</th>
        </tr>
      </thead>
      <tbody>
        <% @refunds.each do |refund| %>
          <tr>
            <td><%= link_to "##{refund.id}", refund, class: "font-mono text-sm text-ink hover:text-credit" %></td>
            <td><%= link_to refund.charge.stripe_payment_intent_id, refund.charge, class: "font-mono text-xs text-ink-dim hover:text-ink" %></td>
            <td class="text-right"><%= amount(refund.amount_cents) %></td>
            <td><%= status_badge(refund.status) %></td>
            <td class="text-right font-mono text-xs text-ink-faint"><%= refund.created_at.strftime("%b %-d · %H:%M") %></td>
          </tr>
        <% end %>
        <% if @refunds.empty? %>
          <tr><td colspan="5" class="px-4 py-16 text-center font-mono text-sm text-ink-faint">no refunds issued yet</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
