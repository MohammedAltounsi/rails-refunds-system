<% content_for :title, @charge.stripe_payment_intent_id %>

<div class="rise">
  <%= link_to "← charges", charges_path, class: "font-mono text-xs text-ink-dim hover:text-ink" %>

  <div class="mt-4 mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="desk-title text-2xl text-ink break-all"><%= @charge.stripe_payment_intent_id %></h1>
    <%= link_to "issue refund", new_refund_path(charge_id: @charge.id), class: "btn btn-primary self-start sm:self-auto" %>
  </div>

  <div class="panel mb-10 px-6">
    <div class="readout">
      <span class="meta">captured</span>
      <span class="font-mono text-sm text-ink-dim"><%= money(@charge.amount_cents) %></span>
    </div>
    <div class="readout">
      <span class="meta">refunded</span>
      <span class="font-mono text-sm text-ink-dim"><%= money(@charge.refunded_cents) %></span>
    </div>
    <div class="readout">
      <span class="meta">refundable</span>
      <%= amount(@charge.refundable_cents) %>
    </div>
  </div>

  <h2 class="meta mb-3">refunds against this charge</h2>
  <div class="panel overflow-x-auto">
    <table class="ledger-table">
      <thead>
        <tr><th>refund</th><th class="text-right">amount</th><th>status</th></tr>
      </thead>
      <tbody>
        <% @refunds.each do |refund| %>
          <tr>
            <td><%= link_to "##{refund.id}", refund, class: "font-mono text-sm text-ink hover:text-credit" %></td>
            <td class="text-right"><%= amount(refund.amount_cents) %></td>
            <td><%= status_badge(refund.status) %></td>
          </tr>
        <% end %>
        <% if @refunds.empty? %>
          <tr><td colspan="3" class="px-4 py-16 text-center font-mono text-sm text-ink-faint">no refunds against this charge</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
