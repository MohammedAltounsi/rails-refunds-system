<% content_for :title, "Charges" %>

<div class="rise">
  <div class="mb-8">
    <h1 class="desk-title text-3xl text-ink">charges</h1>
    <p class="mt-2 max-w-lg text-sm text-ink-dim">
      A charge is money a customer paid. You can never refund more than they paid.
    </p>
  </div>

  <div class="panel overflow-x-auto">
    <table class="ledger-table">
      <thead>
        <tr>
          <th>payment intent</th>
          <th class="text-right">captured</th>
          <th class="text-right">refunded</th>
          <th class="text-right">refundable</th>
        </tr>
      </thead>
      <tbody>
        <% @charges.each do |charge| %>
          <tr>
            <td><%= link_to charge.stripe_payment_intent_id, charge, class: "font-mono text-xs text-ink hover:text-credit" %></td>
            <td class="text-right font-mono text-sm text-ink-dim"><%= money(charge.amount_cents) %></td>
            <td class="text-right font-mono text-sm text-ink-dim"><%= money(charge.refunded_cents) %></td>
            <td class="text-right"><%= amount(charge.refundable_cents) %></td>
          </tr>
        <% end %>
        <% if @charges.empty? %>
          <tr><td colspan="4" class="px-4 py-16 text-center font-mono text-sm text-ink-faint">no charges yet</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
