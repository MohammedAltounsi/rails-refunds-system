<% content_for :title, "Issue a payout" %>

<div class="rise mx-auto max-w-2xl">
  <div class="mb-8">
    <h1 class="desk-title text-3xl text-ink">issue payout</h1>
    <p class="mt-2 text-sm text-ink-dim">
      Choose who to pay and how much. The books record what you owe right away.
    </p>
  </div>

  <%= form_with url: payouts_path, method: :post, class: "panel space-y-6 p-7" do %>
    <div>
      <label class="meta mb-2 block" for="payee">payee</label>
      <input type="text" name="payee" id="payee" required class="field" placeholder="vendor or marketplace seller">
    </div>

    <div>
      <label class="meta mb-2 block" for="amount_cents">amount <span class="text-ink-faint">(halalas)</span></label>
      <input type="number" name="amount_cents" id="amount_cents" min="1" required class="field font-mono">
      <p class="mt-2 font-mono text-xs text-ink-faint">integer minor units · 100 halalas = SAR 1.00</p>
    </div>

    <div>
      <label class="meta mb-2 block" for="idempotency_key">idempotency key <span class="text-ink-faint">(optional)</span></label>
      <input type="text" name="idempotency_key" id="idempotency_key" class="field font-mono text-sm"
             placeholder="a stable key from your own retry logic">
      <p class="mt-2 text-xs text-ink-dim">Leave blank to generate one. The same key twice pays out once.</p>
    </div>

    <div class="flex items-center gap-4 border-t border-line pt-6">
      <button type="submit" class="btn btn-primary">issue payout</button>
      <%= link_to "cancel", payouts_path, class: "font-mono text-xs text-ink-dim hover:text-ink" %>
    </div>
  <% end %>
</div>
