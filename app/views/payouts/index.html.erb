<% content_for :title, "Payouts" %>

<div class="rise">
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="desk-title text-3xl text-ink">payouts</h1>
      <p class="mt-2 max-w-lg text-sm text-ink-dim">
        Pay money out to a vendor. The cash only leaves once the bank confirms it.
      </p>
    </div>
    <%= link_to "issue payout", new_payout_path, class: "btn btn-primary self-start sm:self-auto" %>
  </div>

  <div class="panel overflow-x-auto">
    <table class="ledger-table">
      <thead>
        <tr>
          <th>payout</th>
          <th>payee</th>
          <th class="text-right">amount</th>
          <th>status</th>
          <th class="text-right">created</th>
        </tr>
      </thead>
      <tbody>
        <% @payouts.each do |payout| %>
          <tr>
            <td><%= link_to "##{payout.id}", payout, class: "font-mono text-sm text-ink hover:text-credit" %></td>
            <td class="text-sm text-ink-dim"><%= payout.payee %></td>
            <td class="text-right"><%= amount(payout.amount_cents) %></td>
            <td><%= status_badge(payout.status) %></td>
            <td class="text-right font-mono text-xs text-ink-faint"><%= payout.created_at.strftime("%b %-d · %H:%M") %></td>
          </tr>
        <% end %>
        <% if @payouts.empty? %>
          <tr><td colspan="5" class="px-4 py-16 text-center font-mono text-sm text-ink-faint">no payouts issued yet</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
