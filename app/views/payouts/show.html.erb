<% content_for :title, "Payout ##{@payout.id}" %>

<div class="rise mx-auto max-w-3xl">
  <%= link_to "← payouts", payouts_path, class: "font-mono text-xs text-ink-dim hover:text-ink" %>

  <div class="mt-4 mb-8 flex items-center justify-between gap-4">
    <h1 class="desk-title text-3xl text-ink">payout #<%= @payout.id %></h1>
    <%= status_badge(@payout.status) %>
  </div>

  <dl class="panel">
    <div class="readout px-6">
      <dt class="meta">amount</dt>
      <dd class="text-lg"><%= amount(@payout.amount_cents) %></dd>
    </div>
    <div class="readout px-6">
      <dt class="meta">payee</dt>
      <dd class="text-sm text-ink"><%= @payout.payee %></dd>
    </div>
    <div class="readout px-6">
      <dt class="meta">idempotency key</dt>
      <dd class="font-mono text-xs text-ink-dim break-all text-right"><%= @payout.idempotency_key %></dd>
    </div>
    <div class="readout px-6">
      <dt class="meta">stripe payout id</dt>
      <dd class="font-mono text-xs text-ink-dim"><%= @payout.stripe_payout_id || "—" %></dd>
    </div>
    <% if @payout.failure_reason.present? %>
      <div class="readout px-6">
        <dt class="meta">failure reason</dt>
        <dd class="text-sm text-debit"><%= @payout.failure_reason %></dd>
      </div>
    <% end %>
    <div class="readout px-6">
      <dt class="meta">created</dt>
      <dd class="font-mono text-xs text-ink-dim"><%= @payout.created_at.strftime("%b %-d, %Y · %H:%M") %></dd>
    </div>
  </dl>

  <% if demo_mode? && @payout.status == "processing" %>
    <div class="panel mt-6 p-5">
      <p class="meta mb-1">demo · play Stripe's webhook</p>
      <p class="mb-4 text-xs text-ink-dim">
        This payout is accrued and waiting on Stripe. In production only a
        signed <span class="font-mono text-xs text-ink">payout.paid</span> webhook
        disburses it. Here, stand in for Stripe:
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <%= button_to "▸ Stripe pays this", simulate_payout_path(@payout, outcome: "paid"), method: :post, class: "btn btn-primary" %>
        <%= button_to "Stripe fails this", simulate_payout_path(@payout, outcome: "failed"), method: :post, class: "btn btn-ghost" %>
      </div>
      <p class="mt-3 font-mono text-xs text-ink-faint">
        paying books the disbursement → see it on the <%= link_to "ledger", ledger_path, class: "text-ink-dim hover:text-credit" %>
      </p>
    </div>
  <% end %>
</div>
