<% content_for :title, "Reconciliation" %>

<div class="rise">
  <div class="mb-8">
    <p class="eyebrow mb-2.5">Ledger vs Stripe</p>
    <h1 class="font-display text-4xl tracking-tight text-ink">Reconciliation</h1>
  </div>

  <div class="panel mb-10 flex items-center gap-4 p-6 <%= @result.ok? ? '' : 'border-[#e8cfc6]' %>">
    <span class="chip <%= @result.ok? ? 'chip-settled' : 'chip-failed' %>"><%= @result.ok? ? "Clean" : "Drift" %></span>
    <p class="text-sm text-ink-soft">
      <%= @result.ok? ? "The ledger and Stripe agree to the halala." : "The ledger and Stripe disagree. See the breakdown below." %>
    </p>
  </div>

  <div class="mb-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="panel p-5">
      <p class="eyebrow mb-3">Stripe refunds</p>
      <p class="font-mono text-3xl font-medium text-ink"><%= @result.stripe_count %></p>
    </div>
    <div class="panel p-5">
      <p class="eyebrow mb-3">Matched</p>
      <p class="font-mono text-3xl font-medium text-ink"><%= @result.matched %></p>
    </div>
    <div class="panel p-5">
      <p class="eyebrow mb-3">Entries balance</p>
      <p class="font-mono text-3xl font-medium <%= @result.unbalanced_entries.empty? ? 'text-credit' : 'text-debit' %>">
        <%= @result.unbalanced_entries.empty? ? "yes" : @result.unbalanced_entries.size %>
      </p>
    </div>
    <div class="panel p-5">
      <p class="eyebrow mb-3">Sums to zero</p>
      <p class="font-mono text-3xl font-medium <%= @result.global_sum_cents.zero? ? 'text-credit' : 'text-debit' %>">
        <%= @result.global_sum_cents.zero? ? "yes" : "no" %>
      </p>
    </div>
  </div>

  <% drift = @result.missing.any? || @result.mismatched.any? || @result.orphans.any? %>
  <% if drift %>
    <div class="mb-12 space-y-6">
      <% if @result.missing.any? %>
        <div class="panel p-6">
          <h2 class="mb-1 font-display text-lg text-debit">Missing in ledger</h2>
          <p class="mb-4 text-xs text-ink-soft">Stripe refunded, but we never recorded it — a dropped webhook.</p>
          <ul class="space-y-2">
            <% @result.missing.each do |m| %>
              <li class="flex items-baseline justify-between gap-4 border-t border-line pt-2">
                <span class="font-mono text-xs text-ink-soft"><%= m[:stripe_refund_id] %></span>
                <%= amount(m[:amount_cents]) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @result.mismatched.any? %>
        <div class="panel p-6">
          <h2 class="mb-1 font-display text-lg text-debit">Amount mismatches</h2>
          <p class="mb-4 text-xs text-ink-soft">Recorded, but for a different amount than Stripe.</p>
          <ul class="space-y-2">
            <% @result.mismatched.each do |m| %>
              <li class="flex items-baseline justify-between gap-4 border-t border-line pt-2">
                <span class="font-mono text-xs text-ink-soft"><%= m[:stripe_refund_id] %></span>
                <span class="font-mono text-xs">Stripe <%= money(m[:stripe_cents]) %> · ledger <%= money(m[:ledger_cents]) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @result.orphans.any? %>
        <div class="panel p-6">
          <h2 class="mb-1 font-display text-lg text-debit">Orphan reversals</h2>
          <p class="mb-4 text-xs text-ink-soft">Settled in the ledger with no matching Stripe refund — money leaving the books from nowhere.</p>
          <ul class="space-y-2">
            <% @result.orphans.each do |o| %>
              <li class="flex items-baseline justify-between gap-4 border-t border-line pt-2">
                <span class="font-mono text-xs text-ink-soft">refund #<%= o[:refund_id] %></span>
                <%= amount(o[:ledger_cents]) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>

  <section>
    <h2 class="eyebrow mb-3">Webhook inbox</h2>
    <div class="mb-4 flex flex-wrap gap-2">
      <% @events.each do |status, count| %>
        <span class="chip chip-requested"><%= status %> · <%= count %></span>
      <% end %>
    </div>

    <% if @failed_events.any? %>
      <div class="panel overflow-hidden">
        <table class="ledger-table">
          <thead><tr><th>Event</th><th>Type</th><th>Error</th></tr></thead>
          <tbody>
            <% @failed_events.each do |event| %>
              <tr>
                <td class="font-mono text-xs text-ink-soft"><%= event.event_id %></td>
                <td class="font-mono text-xs"><%= event.event_type %></td>
                <td class="text-sm text-debit"><%= event.error %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-xs text-ink-faint">No failed events. Every delivery was verified, deduped, and processed once.</p>
    <% end %>
  </section>
</div>
