<% content_for :title, "Reconciliation" %>

<h1 class="mb-6 text-xl font-semibold">Reconciliation</h1>

<p class="mb-6 rounded-md px-4 py-3 text-sm <%= @result.ok? ? 'bg-emerald-50 text-emerald-800' : 'bg-rose-50 text-rose-800' %>">
  <%= @result.ok? ? "Clean — ledger and Stripe agree to the halala." : "Drift detected — see below." %>
</p>

<dl class="mb-8 grid grid-cols-2 gap-y-4 rounded-lg border border-slate-200 bg-white p-6 text-sm sm:grid-cols-4">
  <dt class="text-slate-500">Stripe refunds</dt>
  <dd class="font-medium"><%= @result.stripe_count %></dd>
  <dt class="text-slate-500">Matched</dt>
  <dd class="font-medium"><%= @result.matched %></dd>
  <dt class="text-slate-500">Entries balance</dt>
  <dd class="font-medium"><%= @result.unbalanced_entries.empty? ? "yes" : "NO (#{@result.unbalanced_entries.size})" %></dd>
  <dt class="text-slate-500">Ledger sums to zero</dt>
  <dd class="font-medium"><%= @result.global_sum_cents.zero? ? "yes" : "NO (#{@result.global_sum_cents})" %></dd>
</dl>

<% if @result.missing.any? %>
  <h2 class="mb-2 text-sm font-semibold text-rose-700">Missing in ledger (Stripe refunded, we didn't record)</h2>
  <ul class="mb-6 list-disc pl-5 text-sm text-slate-700">
    <% @result.missing.each do |m| %>
      <li><%= m[:stripe_refund_id] %> — <%= money(m[:amount_cents]) %></li>
    <% end %>
  </ul>
<% end %>

<% if @result.mismatched.any? %>
  <h2 class="mb-2 text-sm font-semibold text-rose-700">Amount mismatches</h2>
  <ul class="mb-6 list-disc pl-5 text-sm text-slate-700">
    <% @result.mismatched.each do |m| %>
      <li><%= m[:stripe_refund_id] %> — Stripe <%= money(m[:stripe_cents]) %>, ledger <%= money(m[:ledger_cents]) %></li>
    <% end %>
  </ul>
<% end %>

<% if @result.orphans.any? %>
  <h2 class="mb-2 text-sm font-semibold text-rose-700">Orphan reversals (settled in ledger, no matching Stripe refund)</h2>
  <ul class="mb-6 list-disc pl-5 text-sm text-slate-700">
    <% @result.orphans.each do |o| %>
      <li>refund #<%= o[:refund_id] %> — <%= money(o[:ledger_cents]) %></li>
    <% end %>
  </ul>
<% end %>

<h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Webhook inbox</h2>
<p class="mb-3 text-sm text-slate-600">
  <% @events.each do |status, count| %>
    <span class="mr-4"><%= status %>: <%= count %></span>
  <% end %>
</p>

<% if @failed_events.any? %>
  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr><th class="px-4 py-3">Event</th><th class="px-4 py-3">Type</th><th class="px-4 py-3">Error</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @failed_events.each do |event| %>
          <tr>
            <td class="px-4 py-3 font-mono text-xs"><%= event.event_id %></td>
            <td class="px-4 py-3"><%= event.event_type %></td>
            <td class="px-4 py-3 text-rose-700"><%= event.error %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
