<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Refunds & Payouts" : "Refunds & Payouts Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Refunds & Payouts Ledger">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="border-b border-line bg-panel/70 backdrop-blur">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col gap-4 py-6 sm:flex-row sm:items-end sm:justify-between">
          <%= link_to root_path, class: "group block" do %>
            <p class="eyebrow mb-1.5">Payments · Rails 8</p>
            <h1 class="font-display text-2xl leading-none tracking-tight text-ink">Refunds &amp; Payouts</h1>
          <% end %>
          <p class="max-w-xs text-sm leading-snug text-ink-soft">
            A double-entry ledger that stays balanced through partial refunds, reversed exactly once.
          </p>
        </div>
        <nav class="flex items-center gap-7 pb-0 text-sm font-medium">
          <%= link_to "Refunds",        refunds_path,        class: "nav-link py-4", "aria-current": ("page" if current_page?(refunds_path) || current_page?(root_path)) %>
          <%= link_to "Payouts",        payouts_path,        class: "nav-link py-4", "aria-current": ("page" if current_page?(payouts_path)) %>
          <%= link_to "Charges",        charges_path,        class: "nav-link py-4", "aria-current": ("page" if current_page?(charges_path)) %>
          <%= link_to "Ledger",         ledger_path,         class: "nav-link py-4", "aria-current": ("page" if current_page?(ledger_path)) %>
          <%= link_to "Reconciliation", reconciliation_path, class: "nav-link py-4", "aria-current": ("page" if current_page?(reconciliation_path)) %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-12">
      <% if notice %>
        <div class="mb-8 flex items-start gap-3 rounded-xl border border-[#cfe2d5] bg-credit-soft px-4 py-3 text-sm text-credit">
          <span class="mt-0.5 font-mono text-xs">✓</span><span><%= notice %></span>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-8 flex items-start gap-3 rounded-xl border border-[#e8cfc6] bg-debit-soft px-4 py-3 text-sm text-debit">
          <span class="mt-0.5 font-mono text-xs">!</span><span><%= alert %></span>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="mx-auto max-w-6xl px-6 pb-12">
      <div class="border-t border-line pt-6 text-xs text-ink-faint">
        <span class="font-mono">SAR</span> · integer halalas, no floats · balances derived from an append-only log · money booked only on a signature-verified webhook
      </div>
    </footer>
  </body>
</html>
