<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Refunds & Payouts Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Refunds & Payouts Ledger">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <nav class="container mx-auto flex items-center gap-6 px-5 py-4 text-sm">
        <%= link_to "Refunds & Payouts", root_path, class: "font-semibold text-slate-900" %>
        <%= link_to "Refunds", refunds_path, class: "text-slate-600 hover:text-slate-900" %>
        <%= link_to "Charges", charges_path, class: "text-slate-600 hover:text-slate-900" %>
        <%= link_to "Ledger", ledger_path, class: "text-slate-600 hover:text-slate-900" %>
        <%= link_to "Reconciliation", reconciliation_path, class: "text-slate-600 hover:text-slate-900" %>
      </nav>
    </header>

    <main class="container mx-auto max-w-5xl px-5 py-10">
      <% if notice %>
        <p class="mb-6 rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-800"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
