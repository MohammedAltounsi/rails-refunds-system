<% content_for :title, "Audit trail" %>

<div class="rise">
  <div class="mb-8">
    <h1 class="desk-title text-3xl text-ink">audit trail</h1>
    <p class="mt-2 max-w-lg text-sm text-ink-dim">
      Every issued refund and payout records an actor and an action. On the open
      demo the actor is <span class="font-mono text-xs text-ink">demo</span>; set
      <span class="font-mono text-xs text-ink">ADMIN_PASSWORD</span> and it becomes the
      authenticated operator.
    </p>
  </div>

  <div class="panel overflow-x-auto">
    <table class="ledger-table">
      <thead>
        <tr><th>when</th><th>actor</th><th>action</th><th>detail</th></tr>
      </thead>
      <tbody>
        <% @entries.each do |e| %>
          <tr>
            <td class="font-mono text-xs text-ink-faint"><%= e.created_at.strftime("%b %-d · %H:%M:%S") %></td>
            <td class="font-mono text-xs text-ink"><%= e.actor %></td>
            <td><span class="chip chip-requested"><%= e.action %></span></td>
            <td class="text-sm text-ink-dim"><%= e.detail %></td>
          </tr>
        <% end %>
        <% if @entries.empty? %>
          <tr><td colspan="4" class="px-4 py-16 text-center font-mono text-sm text-ink-faint">no actions recorded yet</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
