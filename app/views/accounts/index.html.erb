<% content_for :title, "Ledger" %>

<div class="rise">
  <div class="mb-8">
    <h1 class="desk-title text-3xl text-ink">ledger</h1>
    <p class="mt-2 text-sm text-ink-dim">Every move of money, written down and never erased. Each balance is added up from the list, so it can't be faked.</p>
  </div>

  <!-- the invariant, stated as the hero readout -->
  <div class="panel mb-10 flex flex-col gap-5 p-7 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="meta mb-3">global sum · every posting ever</p>
      <p class="font-mono text-5xl font-medium <%= @global_sum.zero? ? 'text-credit' : 'text-debit' %>">
        <%= money(@global_sum) %>
      </p>
    </div>
    <p class="max-w-xs text-sm leading-snug text-ink-dim sm:text-right">
      Money is only ever moved, never created or destroyed. Every entry's postings sum to zero, so the whole book does too.
    </p>
  </div>

  <div class="grid gap-8 lg:grid-cols-5">
    <section class="lg:col-span-2">
      <h2 class="meta mb-3">accounts</h2>
      <div class="panel overflow-hidden">
        <table class="ledger-table">
          <thead><tr><th>account</th><th class="text-right">balance</th></tr></thead>
          <tbody>
            <% @accounts.each do |account| %>
              <tr>
                <td class="font-mono text-xs text-ink-dim"><%= account.name %></td>
                <td class="text-right"><%= amount(account.balance_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="mt-3 font-mono text-xs text-ink-faint">no stored balance to drift</p>
    </section>

    <section class="lg:col-span-3">
      <h2 class="meta mb-3">recent entries</h2>
      <div class="space-y-3">
        <% @entries.each do |entry| %>
          <div class="panel p-5">
            <div class="mb-3 flex items-baseline justify-between gap-4">
              <p class="text-sm text-ink"><%= entry.memo %></p>
              <p class="font-mono text-xs text-ink-faint"><%= entry.created_at.strftime("%b %-d · %H:%M") %></p>
            </div>
            <div class="space-y-1.5 border-t border-line pt-3">
              <% entry.postings.each do |p| %>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-mono text-xs text-ink-dim"><%= p.account.name %></span>
                  <%= amount(p.amount_cents) %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @entries.empty? %>
          <div class="panel px-4 py-16 text-center font-mono text-sm text-ink-faint">no entries yet</div>
        <% end %>
      </div>
    </section>
  </div>
</div>
